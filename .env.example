# Copier en ".env" pour le developpement local.
#
# En production cette valeur n'est PAS lue depuis un fichier .env : l'app est
# construite en SPA statique, donc runtimeConfig.public est figee dans le
# bundle au build. Elle est passee en build-arg NUXT_PUBLIC_API_BASE
# (cf. Dockerfile et .github/workflows/deploy.yml), et vaut "/api" : le site
# et l'API partagent le domaine, nginx route /api/ vers le backend.
#
# Consequence : changer d'URL d'API en production impose un rebuild d'image.

# Local : l'API tourne a cote, sur le port 5000.
NUXT_PUBLIC_API_BASE=http://localhost:5000/api
