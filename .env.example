# Copier en ".env" pour le developpement local.
# En production ces valeurs sont injectees par docker-compose sur l'EC2
# (cf. instad-infra/docker-compose.yml), jamais par ce fichier.

# URL de l'API vue par le NAVIGATEUR.
# Local      : l'API tourne a cote, sur le port 5000.
# Production : https://rgph.instad.dj/api (nginx, meme domaine que le site).
NUXT_PUBLIC_API_BASE=http://localhost:5000/api

# URL de l'API vue par le SERVEUR pendant le SSR.
# A laisser vide en local : useApiBase() retombe alors sur NUXT_PUBLIC_API_BASE.
# En production : http://map-backend:5000/api (reseau Docker), car le domaine
# public n'est pas joignable depuis l'interieur de l'EC2.
# NUXT_API_BASE_INTERNAL=
